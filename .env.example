# Copy to .env locally. Never commit the real file.
HA_BASE_URL=http://homeassistant.local
HA_TOKEN=replace_with_home_assistant_long_lived_access_token
HA_DISCOVERY_ENABLED=true

INTENT_PROVIDER=minimax
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=replace_with_minimax_api_key
MINIMAX_MODEL=MiniMax-M3
MINIMAX_THINKING=disabled
MINIMAX_MAX_COMPLETION_TOKENS=1024
MINIMAX_TIMEOUT_MS=30000
MINIMAX_RETRIES=0

INTENT_ROUTER_BIND=127.0.0.1
INTENT_ROUTER_PORT=8787
INTENT_ROUTER_DRY_RUN=true
INTENT_ROUTER_ALLOW_LIVE_EXECUTION=false
INTENT_ROUTER_SHARED_SECRET=replace_with_random_secret
# 相对于 intent-router/ 启动目录。
INTENT_ROUTER_CONFIG=../config/intent-router.example.yaml
