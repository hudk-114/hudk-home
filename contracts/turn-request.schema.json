{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hudk-home.local/contracts/turn-request.schema.json",
  "title": "Hudk Home turn request",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "language", "source"],
  "properties": {
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "language": { "type": "string", "enum": ["zh", "zh-CN"] },
    "source": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]+$"
    },
    "actor": { "type": "string", "minLength": 1, "maxLength": 64 },
    "conversation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "last_target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        }
      }
    },
    "dry_run": { "type": "boolean" }
  }
}
